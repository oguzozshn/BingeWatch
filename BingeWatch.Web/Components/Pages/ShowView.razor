@page "/show/{TmdbId:int}"
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

@*
    Dizi sayfası bilerek herkese açık: ürünün en çok aranan ve dışarıdan
    bağlantı alan sayfası bu. [Authorize] arkasındayken arama motoru hiçbir
    dizi sayfasını göremiyordu (ROADMAP §6: "dizi ve inceleme sayfaları SEO
    için prerender edilmeli" — kimlik duvarı bunu baştan imkânsız kılıyordu).

    Kişisel katman (puanın, ilerlemen, watchlist, favori, arkadaş puanları)
    <AuthorizeView> arkasında; anonim ziyaretçi diziyi görür, kendi verisini
    görmez. İlgili API uçları zaten [Authorize] — istekler de atılmıyor.
*@

@if (loading)
{
    <p class="show-loading">Yükleniyor...</p>
}
else if (show == null)
{
    <p class="show-loading">Dizi bulunamadı.</p>
}
else
{
    @* schema.org TVSeries JSON-LD'si PageMeta üzerinden basılıyor: aynı sayfada
       ikinci bir <HeadContent> ilkini eziyor, ayrı blokta yazınca çıktıya hiç
       düşmüyordu. Botlar JS çalıştırmadığı için prerender'da olması şart. *@
    <PageMeta Title="@MetaTitle" Description="@MetaDescription"
              ImageUrl="@SocialImageUrl" OgType="video.tv_show"
              JsonLd="@StructuredData" />

    <div class="show-container">
        <div class="left-panel">
            <img src="@PosterUrl(show.PosterPath)" alt="@show.Name" class="poster" />

            <div class="info">
                <h1>@show.Name</h1>
                <p class="tmdb-line">
                    <span class="rating">⭐ @show.VoteAverage.ToString("0.0")</span>
                    <span class="muted">TMDb · @show.VoteCount.ToString("N0") oy</span>
                </p>
                <p class="muted">
                    @(show.FirstAirDate?.Year.ToString() ?? "—")@(string.IsNullOrEmpty(show.Status) ? "" : $" · {show.Status}")
                </p>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="my-rating">
                        <span class="my-rating-label">Puanın</span>
                        <StarRating Value="myRatings.ShowRating" ShowValue="true" Size="lg"
                                    AriaLabel="Diziye puan ver"
                                    ValueChanged="RateShowAsync" />
                    </div>

                    <div class="list-actions">
                        <button type="button" class="watchlist-btn" @onclick="ToggleWatchlist"
                                aria-label="@(IsInWatchlist ? "Watchlist'ten çıkar" : "Watchlist'e ekle")">
                            <span aria-hidden="true">@(IsInWatchlist ? "❤️" : "♡")</span>
                        </button>

                        @if (IsInWatchlist)
                        {
                            <button type="button" class="favorite-btn @(isFavorite ? "on" : "")"
                                    @onclick="ToggleFavoriteAsync"
                                    title="Profilinde favori olarak göster">
                                @(isFavorite ? "★ Favori" : "☆ Favoriye ekle")
                            </button>
                        }

                        <AddToListButton TmdbShowId="TmdbId" />
                    </div>

                    @if (progress != null && progress.TotalEpisodes > 0)
                    {
                        var pct = (int)Math.Round(100.0 * progress.WatchedEpisodes / progress.TotalEpisodes);
                        <div class="progress-block">
                            <div class="progress-bar"><div class="progress-fill" style="width:@(pct)%"></div></div>
                            <p class="progress-label">@progress.WatchedEpisodes / @progress.TotalEpisodes bölüm izlendi (@pct%)</p>
                        </div>
                    }
                </Authorized>
                <NotAuthorized>
                    <p class="signin-nudge">
                        <a href="/login">Giriş yap</a> — bölüm bölüm takip et, puanla, listene ekle.
                    </p>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="right-panel">
            @* ARIA sekme deseni: sekme şeridinde odak tek durak (yalnızca aktif
               sekme tabindex=0), sekmeler arası geçiş ok tuşlarıyla. Eskiden dört
               sekmenin dördü de sekme sırasındaydı ve panelle bağları yoktu. *@
            <div class="tabs" role="tablist" aria-label="Dizi bölümleri"
                 @onkeydown="OnTabKeyDown">
                @foreach (var t in AllTabs)
                {
                    var tab = t;
                    <button type="button" role="tab" class="tab @(activeTab == tab ? "active" : "")"
                            id="@TabId(tab)"
                            aria-selected="@Aria(activeTab == tab)"
                            aria-controls="show-tabpanel"
                            tabindex="@(activeTab == tab ? 0 : -1)"
                            @onclick="() => SwitchTabAsync(tab)">@TabLabel(tab)</button>
                }
            </div>

            @switch (activeTab)
            {
                case Tab.Overview:
                    <section class="tab-panel" id="show-tabpanel" role="tabpanel"
                             aria-labelledby="@TabId(activeTab)" tabindex="0">
                        @if (!string.IsNullOrWhiteSpace(show.Overview))
                        {
                            <p class="overview">@show.Overview</p>
                        }

                        @if (summary != null)
                        {
                            <h5 class="section-title">BingeWatch puanları</h5>
                            <RatingHistogram Summary="summary" />
                        }

                        @if (friendRatings is { Count: > 0 })
                        {
                            <h5 class="section-title">Takip ettiklerinin puanı</h5>
                            <div class="friend-ratings">
                                <div class="friend-average">
                                    <strong>@friendRatings.Average!.Value.ToString("0.0")</strong>
                                    <span>@friendRatings.Count kişi</span>
                                </div>
                                @foreach (var friend in friendRatings.Ratings)
                                {
                                    <div class="friend-row">
                                        <a href="@ProfileUrl(friend.Username)">@friend.DisplayName</a>
                                        <StarRating Value="friend.Value" ReadOnly="true" Size="sm"
                                                    AriaLabel="@($"{friend.DisplayName} puanı")" />
                                    </div>
                                }
                            </div>
                        }

                        <h5 class="section-title">Bölüm ısı haritası</h5>
                        <EpisodeHeatmap Seasons="show.Seasons" PersonalRatings="myRatings.EpisodeRatings" />

                        <AuthorizeView>
                            <Authorized>
                                <h5 class="section-title">Sezon puanların</h5>
                                <div class="season-ratings">
                                    @foreach (var season in show.Seasons)
                                    {
                                        var s = season;
                                        <div class="season-rating-row">
                                            <span>@SeasonLabel(s)</span>
                                            <StarRating Value="@SeasonRating(s.SeasonNumber)" Size="sm" ShowValue="true"
                                                        AriaLabel="@($"{SeasonLabel(s)} puanı")"
                                                        ValueChanged="v => RateSeasonAsync(s.SeasonNumber, v)" />
                                        </div>
                                    }
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </section>
                    break;

                case Tab.Episodes:
                    <section class="tab-panel" id="show-tabpanel" role="tabpanel"
                             aria-labelledby="@TabId(activeTab)" tabindex="0">
                        @foreach (var season in show.Seasons)
                        {
                            var s = season;
                            var expanded = expandedSeasons.Contains(s.SeasonNumber);
                            <div class="season">
                                <div class="season-header">
                                    <button type="button" class="season-toggle" aria-expanded="@Aria(expanded)"
                                            @onclick="() => ToggleSeason(s.SeasonNumber)">
                                        <span class="chevron">@(expanded ? "▾" : "▸")</span>
                                        <h4>@SeasonLabel(s)</h4>
                                        <span class="season-count">@WatchedInSeason(s)/@s.Episodes.Count</span>
                                    </button>
                                    <AuthorizeView>
                                        <Authorized>
                                            <button type="button" class="season-action"
                                                    @onclick="() => MarkSeasonWatched(s)">Sezonu izledim</button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>

                                @if (expanded)
                                {
                                    <div class="episodes">
                                        @foreach (var episode in s.Episodes)
                                        {
                                            var ep = episode;
                                            var unaired = ep.AirDate.HasValue && ep.AirDate.Value.Date > DateTime.UtcNow.Date;
                                            <div class="episode-row @(ep.Watched ? "watched" : "") @(unaired ? "unaired" : "")">
                                                <AuthorizeView>
                                                    <Authorized>
                                                        <label class="episode-checkbox">
                                                            <input type="checkbox" checked="@ep.Watched" disabled="@unaired"
                                                                   @onchange="e => MarkEpisodeWatched(ep, (bool)e.Value!)" />
                                                            <span>@ep.EpisodeNumber. @ep.Name</span>
                                                        </label>
                                                    </Authorized>
                                                    <NotAuthorized>
                                                        @* Anonim ziyaretçi bölüm listesini görür ama işaretleyemez. *@
                                                        <span class="episode-title">@ep.EpisodeNumber. @ep.Name</span>
                                                    </NotAuthorized>
                                                </AuthorizeView>

                                                <div class="episode-actions">
                                                    <AuthorizeView>
                                                        <Authorized>
                                                            @if (!unaired)
                                                            {
                                                                <StarRating Value="@EpisodeRating(ep.Id)" Size="sm"
                                                                            AriaLabel="@($"{ep.EpisodeNumber}. bölüme puan ver")"
                                                                            ValueChanged="v => RateEpisodeAsync(ep.Id, v)" />
                                                            }
                                                            @if (!ep.Watched && !unaired)
                                                            {
                                                                <button type="button" class="up-to-btn"
                                                                        @onclick="() => MarkWatchedUpTo(ep)">buraya kadar</button>
                                                            }
                                                        </Authorized>
                                                    </AuthorizeView>
                                                    @if (unaired && ep.AirDate.HasValue)
                                                    {
                                                        <span class="air-date">@ep.AirDate.Value.ToString("d MMM yyyy")</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </section>
                    break;

                case Tab.Reviews:
                    <section class="tab-panel" id="show-tabpanel" role="tabpanel"
                             aria-labelledby="@TabId(activeTab)" tabindex="0">
                        <AuthorizeView>
                        <Authorized>
                        <div class="review-form">
                            <div class="review-form-head">
                                <h5 class="section-title">@(editingId == null ? "İnceleme yaz" : "İncelemeni düzenle")</h5>
                                <select class="form-select form-select-sm season-select" @bind="draftSeasonNumber">
                                    <option value="">Dizi geneli</option>
                                    @foreach (var s in show.Seasons)
                                    {
                                        <option value="@s.SeasonNumber">@SeasonLabel(s)</option>
                                    }
                                </select>
                            </div>

                            <textarea class="form-control" rows="4" placeholder="Ne düşündün?"
                                      @bind="draftBody" @bind:event="oninput"></textarea>

                            <div class="review-form-actions">
                                <label class="spoiler-check">
                                    <input type="checkbox" @bind="draftHasSpoilers" />
                                    <span>Spoiler içeriyor</span>
                                </label>

                                @if (reviewError != null)
                                {
                                    <span class="review-error">@reviewError</span>
                                }

                                @if (editingId != null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Vazgeç</button>
                                }
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@(string.IsNullOrWhiteSpace(draftBody) || savingReview)"
                                        @onclick="SaveReviewAsync">
                                    @(savingReview ? "Kaydediliyor..." : "Kaydet")
                                </button>
                            </div>
                        </div>
                        </Authorized>
                        </AuthorizeView>

                        @if (reviews.Count == 0)
                        {
                            <p class="muted">Bu diziye henüz inceleme yazılmamış.</p>
                        }
                        else
                        {
                            <div class="review-list">
                                @foreach (var review in reviews)
                                {
                                    <ReviewCard Review="review"
                                                CanEdit="@(review.UserId == currentUserId)"
                                                OnEdit="StartEdit"
                                                OnDelete="DeleteReviewAsync" />
                                }
                            </div>
                        }
                    </section>
                    break;

                case Tab.Similar:
                    <section class="tab-panel" id="show-tabpanel" role="tabpanel"
                             aria-labelledby="@TabId(activeTab)" tabindex="0">
                        @if (similar == null)
                        {
                            <p class="muted">Yükleniyor...</p>
                        }
                        else if (similar.Count == 0)
                        {
                            <p class="muted">TMDb bu dizi için benzer yapım önermiyor.</p>
                        }
                        else
                        {
                            <div class="similar-grid">
                                @foreach (var item in similar)
                                {
                                    <a class="similar-card" href="/show/@item.Id">
                                        <img src="@PosterUrl(item.PosterPath)" alt="@item.Name" />
                                        <span class="similar-name">@item.Name</span>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                    break;
            }
        </div>
    </div>
}

@code {
    [Parameter] public int TmdbId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum Tab { Overview, Episodes, Reviews, Similar }

    private static readonly Tab[] AllTabs = { Tab.Overview, Tab.Episodes, Tab.Reviews, Tab.Similar };

    private static string TabLabel(Tab tab) => tab switch
    {
        Tab.Overview => "Genel Bakış",
        Tab.Episodes => "Bölümler",
        Tab.Reviews => "İncelemeler",
        _ => "Benzer"
    };

    /// <summary>Panelin <c>aria-labelledby</c>'si buraya bakıyor.</summary>
    private static string TabId(Tab tab) => $"show-tab-{tab.ToString().ToLowerInvariant()}";

    /// <summary>
    /// ARIA sekme deseni klavye sözleşmesi: sol/sağ ok komşu sekmeye (uçlarda
    /// başa/sona sarar), Home/End ilk ve son sekmeye gider. Seçilen sekme aynı
    /// anda etkinleşiyor — panel içeriği zaten tıklamada da anında yükleniyor.
    /// </summary>
    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        var current = Array.IndexOf(AllTabs, activeTab);

        var next = e.Key switch
        {
            "ArrowRight" => (current + 1) % AllTabs.Length,
            "ArrowLeft" => (current - 1 + AllTabs.Length) % AllTabs.Length,
            "Home" => 0,
            "End" => AllTabs.Length - 1,
            _ => -1
        };

        if (next < 0 || next == current)
            return;

        await SwitchTabAsync(AllTabs[next]);

        // Odak da yeni sekmeye geçmeli. Seçim değişip odak eski sekmede kalırsa
        // ekran okuyucu yeni sekmeyi hiç duyurmaz ve odak, tabindex="-1"e düşen
        // bir düğmede mahsur kalır — şeritteki "tek durak" kuralı bozulur.
        await JS.InvokeVoidAsync("bingeWatchFocusElement", TabId(AllTabs[next]));
    }

    private ShowDetailDto? show;
    private ShowProgressDto? progress;
    private ShowRatingsDto myRatings = new();
    private RatingSummaryDto? summary;
    private FriendRatingsDto? friendRatings;
    private List<ReviewDto> reviews = new();
    private List<SeriesDto>? similar;

    private bool IsInWatchlist;
    private bool isFavorite;
    private bool loading = true;
    private string? currentUserId;

    private Tab activeTab = Tab.Overview;

    // Sezonlar varsayılan olarak kapalı; çok sezonlu dizilerde sayfa uzamasın.
    private readonly HashSet<int> expandedSeasons = new();

    // İnceleme formu
    private string? draftSeasonNumber;
    private string draftBody = string.Empty;
    private bool draftHasSpoilers;
    private int? editingId;
    private bool savingReview;
    private string? reviewError;

    private async Task<HttpClient> GetApiAsync()
    {
        var client = HttpClientFactory.CreateClient("ApiClient");
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        activeTab = Tab.Overview;
        expandedSeasons.Clear();
        similar = null;
        ResetDraft();

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        var api = await GetApiAsync();

        // Dizi bilgisi ve puan özeti anonime de açık (AllowAnonymous).
        show = await api.GetFromJsonAsync<ShowDetailDto>($"api/shows/{TmdbId}");
        if (show != null)
        {
            summary = await api.GetFromJsonAsync<RatingSummaryDto>($"api/shows/{TmdbId}/ratings/summary");

            // Kişisel katman yalnızca giriş yapmışta çekiliyor; anonim istekte
            // bu uçlar 401 döner ve GetFromJsonAsync fırlatırdı.
            if (currentUserId != null)
            {
                progress = await api.GetFromJsonAsync<ShowProgressDto>($"api/shows/{TmdbId}/progress");
                IsInWatchlist = await api.GetFromJsonAsync<bool>($"api/watchlist/status?seriesId={TmdbId}");
                myRatings = await api.GetFromJsonAsync<ShowRatingsDto>($"api/shows/{TmdbId}/ratings/mine") ?? new();
                friendRatings = await api.GetFromJsonAsync<FriendRatingsDto>($"api/shows/{TmdbId}/ratings/friends");
                isFavorite = IsInWatchlist && await api.GetFromJsonAsync<bool>($"api/watchlist/{TmdbId}/favorite");
            }

            // İzlenmekte olan sezon açık başlasın: ilk yarım kalmış sezon.
            var current = show.Seasons.FirstOrDefault(s => s.Episodes.Any(e => !e.Watched))
                          ?? show.Seasons.FirstOrDefault();
            if (current != null)
                expandedSeasons.Add(current.SeasonNumber);
        }

        loading = false;
    }

    private async Task SwitchTabAsync(Tab tab)
    {
        activeTab = tab;

        // İnceleme ve benzer listesi yalnızca sekmesi ilk açıldığında çekilir.
        var api = await GetApiAsync();

        if (tab == Tab.Reviews)
            reviews = await api.GetFromJsonAsync<List<ReviewDto>>($"api/reviews/show/{TmdbId}") ?? new();
        else if (tab == Tab.Similar && similar == null)
            similar = await api.GetFromJsonAsync<List<SeriesDto>>($"api/shows/{TmdbId}/similar") ?? new();
    }

    private static string PosterUrl(string? path)
    {
        if (string.IsNullOrEmpty(path))
            return "";

        // Katalog API'si göreli yol döner; arama sonuçlarında tam URL gelebilir.
        return path.StartsWith("http") ? path : $"https://image.tmdb.org/t/p/w500{path}";
    }

    // ----- SEO ---------------------------------------------------------------

    private string MetaTitle =>
        show!.FirstAirDate.HasValue ? $"{show.Name} ({show.FirstAirDate.Value.Year})" : show.Name;

    /// <summary>
    /// Dizinin özeti; yoksa alanlardan bir cümle kuruluyor. Boş açıklama arama
    /// sonucunda sayfayı adsız bırakıyor.
    /// </summary>
    private string MetaDescription =>
        !string.IsNullOrWhiteSpace(show!.Overview)
            ? show.Overview
            : $"{show.Name} — {show.Seasons.Count} sezon, " +
              $"{show.Seasons.Sum(s => s.Episodes.Count)} bölüm. BingeWatch'ta bölüm bölüm takip et, puanla, incele.";

    /// <summary>Paylaşım görseli mutlak olmalı; botlar göreli yolu çözemiyor.</summary>
    private string? SocialImageUrl => string.IsNullOrEmpty(show!.BackdropPath ?? show.PosterPath)
        ? null
        : $"https://image.tmdb.org/t/p/w780{show.BackdropPath ?? show.PosterPath}";

    private string StructuredData
    {
        get
        {
            var data = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "TVSeries",
                ["name"] = show!.Name,
                ["url"] = Navigation.Uri,
                ["numberOfSeasons"] = show.Seasons.Count,
                ["numberOfEpisodes"] = show.Seasons.Sum(s => s.Episodes.Count)
            };

            if (!string.IsNullOrWhiteSpace(show.Overview))
                data["description"] = show.Overview;

            if (!string.IsNullOrEmpty(show.PosterPath))
                data["image"] = $"https://image.tmdb.org/t/p/w500{show.PosterPath}";

            if (show.FirstAirDate.HasValue)
                data["datePublished"] = show.FirstAirDate.Value.ToString("yyyy-MM-dd");

            // Puan bloğu yalnızca gerçek oy varken; oysuz aggregateRating
            // yapılandırılmış veri doğrulamasında hata veriyor.
            if (show.VoteCount > 0)
            {
                data["aggregateRating"] = new Dictionary<string, object>
                {
                    ["@type"] = "AggregateRating",
                    ["ratingValue"] = Math.Round(show.VoteAverage, 1),
                    ["ratingCount"] = show.VoteCount,
                    ["bestRating"] = 10,
                    ["worstRating"] = 0
                };
            }

            // </script> kaçışı: özet metninde geçerse sayfayı bozardı.
            return System.Text.Json.JsonSerializer
                .Serialize(data, new System.Text.Json.JsonSerializerOptions
                {
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                })
                .Replace("<", "\\u003c");
        }
    }

    private static string SeasonLabel(SeasonDetailDto season) =>
        string.IsNullOrEmpty(season.Name) ? $"Sezon {season.SeasonNumber}" : season.Name!;

    private static int WatchedInSeason(SeasonDetailDto season) => season.Episodes.Count(e => e.Watched);

    private void ToggleSeason(int seasonNumber)
    {
        if (!expandedSeasons.Remove(seasonNumber))
            expandedSeasons.Add(seasonNumber);
    }

    private decimal? SeasonRating(int seasonNumber) =>
        myRatings.SeasonRatings.TryGetValue(seasonNumber, out var v) ? v : null;

    private decimal? EpisodeRating(int episodeId) =>
        myRatings.EpisodeRatings.TryGetValue(episodeId, out var v) ? v : null;

    // ----- Puanlama -------------------------------------------------------

    private async Task RateShowAsync(decimal? value)
    {
        var request = new SetRatingRequest { TargetType = RatingTargetType.Show, Value = value ?? 0 };
        if (!await SendRatingAsync(request, value))
            return;

        myRatings.ShowRating = value;
        // Dizi puanı ortalamayı değiştirir; histogram tazelenmeli.
        var api = await GetApiAsync();
        summary = await api.GetFromJsonAsync<RatingSummaryDto>($"api/shows/{TmdbId}/ratings/summary");
    }

    private async Task RateSeasonAsync(int seasonNumber, decimal? value)
    {
        var request = new SetRatingRequest
        {
            TargetType = RatingTargetType.Season,
            SeasonNumber = seasonNumber,
            Value = value ?? 0
        };
        if (!await SendRatingAsync(request, value))
            return;

        if (value.HasValue)
            myRatings.SeasonRatings[seasonNumber] = value.Value;
        else
            myRatings.SeasonRatings.Remove(seasonNumber);
    }

    private async Task RateEpisodeAsync(int episodeId, decimal? value)
    {
        var request = new SetRatingRequest
        {
            TargetType = RatingTargetType.Episode,
            EpisodeId = episodeId,
            Value = value ?? 0
        };
        if (!await SendRatingAsync(request, value))
            return;

        if (value.HasValue)
            myRatings.EpisodeRatings[episodeId] = value.Value;
        else
            myRatings.EpisodeRatings.Remove(episodeId);
    }

    /// <summary><paramref name="value"/> null ise puan silinir, doluysa yazılır.</summary>
    private async Task<bool> SendRatingAsync(SetRatingRequest request, decimal? value)
    {
        var api = await GetApiAsync();

        var response = value.HasValue
            ? await api.PutAsJsonAsync($"api/shows/{TmdbId}/ratings", request)
            : await api.SendAsync(new HttpRequestMessage(HttpMethod.Delete, $"api/shows/{TmdbId}/ratings")
            {
                Content = JsonContent.Create(request)
            });

        return response.IsSuccessStatusCode;
    }

    // ----- İnceleme -------------------------------------------------------

    private void ResetDraft()
    {
        draftSeasonNumber = null;
        draftBody = string.Empty;
        draftHasSpoilers = false;
        editingId = null;
        reviewError = null;
    }

    private void StartEdit(ReviewDto review)
    {
        editingId = review.Id;
        draftSeasonNumber = review.SeasonNumber?.ToString();
        draftBody = review.Body;
        draftHasSpoilers = review.HasSpoilers;
        reviewError = null;
    }

    private void CancelEdit() => ResetDraft();

    private async Task SaveReviewAsync()
    {
        if (string.IsNullOrWhiteSpace(draftBody))
            return;

        savingReview = true;
        reviewError = null;

        var api = await GetApiAsync();
        var request = new UpsertReviewRequest
        {
            SeasonNumber = string.IsNullOrEmpty(draftSeasonNumber) ? null : int.Parse(draftSeasonNumber),
            Body = draftBody,
            HasSpoilers = draftHasSpoilers
        };

        var response = await api.PutAsJsonAsync($"api/reviews/show/{TmdbId}", request);
        savingReview = false;

        if (!response.IsSuccessStatusCode)
        {
            reviewError = "İnceleme kaydedilemedi.";
            return;
        }

        ResetDraft();
        reviews = await api.GetFromJsonAsync<List<ReviewDto>>($"api/reviews/show/{TmdbId}") ?? new();
    }

    private async Task DeleteReviewAsync(ReviewDto review)
    {
        var api = await GetApiAsync();
        var response = await api.DeleteAsync($"api/reviews/{review.Id}");
        if (!response.IsSuccessStatusCode)
        {
            reviewError = "İnceleme silinemedi.";
            return;
        }

        if (editingId == review.Id)
            ResetDraft();

        reviews = await api.GetFromJsonAsync<List<ReviewDto>>($"api/reviews/show/{TmdbId}") ?? new();
    }

    // ----- İzleme takibi --------------------------------------------------

    private async Task ToggleWatchlist()
    {
        if (show == null) return;

        var api = await GetApiAsync();
        var series = new SeriesDto
        {
            Id = show.TmdbId,
            Name = show.Name,
            Overview = show.Overview,
            PosterPath = show.PosterPath ?? "",
            FirstAirDate = show.FirstAirDate?.ToString("yyyy-MM-dd")
        };

        var response = await api.PostAsJsonAsync("api/watchlist/toggle", series);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ToggleResponse>();
            IsInWatchlist = result!.IsInWatchList;

            // Listeden çıkan dizi favori de kalmasın.
            if (!IsInWatchlist)
                isFavorite = false;
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        var api = await GetApiAsync();
        var response = await api.PutAsJsonAsync($"api/watchlist/{TmdbId}/favorite",
            new SetFavoriteRequest { IsFavorite = !isFavorite });

        if (response.IsSuccessStatusCode)
            isFavorite = !isFavorite;
    }

    /// <summary>Profil rotası "/@kullaniciadi"; "@" Razor'da kaçış gerektirdiği için burada birleştiriliyor.</summary>
    private static string ProfileUrl(string username) => "/" + '@' + username;

    private async Task MarkEpisodeWatched(EpisodeDetailDto episode, bool watched)
    {
        var api = await GetApiAsync();
        var response = await api.PostAsJsonAsync(
            $"api/shows/{TmdbId}/episodes/{episode.Id}/watched",
            new MarkWatchedRequest { Watched = watched });

        if (response.IsSuccessStatusCode)
        {
            episode.Watched = watched;
            progress = await response.Content.ReadFromJsonAsync<ShowProgressDto>();
        }
    }

    private async Task MarkSeasonWatched(SeasonDetailDto season)
    {
        var api = await GetApiAsync();
        var response = await api.PostAsJsonAsync(
            $"api/shows/{TmdbId}/seasons/{season.SeasonNumber}/watched",
            new MarkWatchedRequest { Watched = true });

        if (response.IsSuccessStatusCode)
        {
            foreach (var ep in season.Episodes.Where(e => !e.AirDate.HasValue || e.AirDate.Value <= DateTime.UtcNow))
                ep.Watched = true;

            var result = await response.Content.ReadFromJsonAsync<SeasonWatchedResponse>();
            progress = result?.Progress;
        }
    }

    private async Task MarkWatchedUpTo(EpisodeDetailDto target)
    {
        if (show == null) return;

        var api = await GetApiAsync();
        var response = await api.PostAsync($"api/shows/{TmdbId}/watched-up-to/{target.Id}", null);

        if (response.IsSuccessStatusCode)
        {
            var targetSeason = show.Seasons.First(s => s.Episodes.Any(e => e.Id == target.Id));
            foreach (var season in show.Seasons.Where(s => s.SeasonNumber < targetSeason.SeasonNumber))
                foreach (var ep in season.Episodes)
                    ep.Watched = true;

            foreach (var ep in targetSeason.Episodes.Where(e => e.EpisodeNumber <= target.EpisodeNumber))
                ep.Watched = true;

            var result = await response.Content.ReadFromJsonAsync<SeasonWatchedResponse>();
            progress = result?.Progress;
        }
    }

    private class ToggleResponse
    {
        public bool IsInWatchList { get; set; }
    }

    private class SeasonWatchedResponse
    {
        public int AffectedEpisodes { get; set; }
        public ShowProgressDto? Progress { get; set; }
    }
}
