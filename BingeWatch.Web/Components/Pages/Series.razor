@page "/series"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

@using BingeWatch.Web.Dtos

<PageTitle>Diziler</PageTitle>

<h1 class="section-title" id="popular-heading">BU HAFTANIN POPÜLER DİZİLERİ</h1>

@if (series == null)
{
    <p>Yükleniyor...</p>
}
else
{
    @* Oklar yalnızca "<" ">" karakteri taşıyordu; ekran okuyucu "küçüktür"
       diye okuyordu. Karakter gizlendi, erişilebilir ad ayrıca veriliyor. *@
    <div class="carousel-container">
        <button type="button" class="carousel-arrow left" aria-label="Önceki diziler"
                @onclick="PrevSlide" disabled="@(startIndex == 0)">
            <span aria-hidden="true">&#60;</span>
        </button>

        <ul class="carousel-track" aria-labelledby="popular-heading">
            @foreach (var item in VisibleSeries)
            {
                <li>
                    <a class="carousel-card" href="/show/@item.Id">
                        <img src="@($"https://image.tmdb.org/t/p/w500{item.PosterPath}")"
                             alt="" class="carousel-poster" />
                        <span class="carousel-title">@item.Name</span>
                    </a>
                </li>
            }
        </ul>

        <button type="button" class="carousel-arrow right" aria-label="Sonraki diziler"
                @onclick="NextSlide" disabled="@(series == null || startIndex + cardsPerView >= series.Count)">
            <span aria-hidden="true">&#62;</span>
        </button>
    </div>
}

@code {
    private List<SeriesDto>? series;
    private int startIndex = 0;
    private int cardsPerView = 4;
    private HttpClient Api => HttpClientFactory.CreateClient("ApiClient");

    private IEnumerable<SeriesDto> VisibleSeries => series?.Skip(startIndex).Take(cardsPerView) ?? Enumerable.Empty<SeriesDto>();

    protected override async Task OnInitializedAsync()
    {
        series = await Api.GetFromJsonAsync<List<SeriesDto>>("api/series");
    }

    private void NextSlide()
    {
        if (series != null && startIndex + cardsPerView < series.Count)
        {
            startIndex++;
        }
    }

    private void PrevSlide()
    {
        if (startIndex > 0)
        {
            startIndex--;
        }
    }

}
