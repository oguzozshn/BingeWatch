@page "/show/{TmdbId:int}"
@attribute [Authorize]
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory

@using BingeWatch.Web.Dtos

@if (loading)
{
    <p class="show-loading">Yükleniyor...</p>
}
else if (show == null)
{
    <p class="show-loading">Dizi bulunamadı.</p>
}
else
{
    <div class="show-container">
        <div class="left-panel">
            <img src="@PosterUrl(show.PosterPath)" alt="@show.Name" class="poster" />

            <div class="info">
                <h2>@show.Name</h2>
                <p><span class="rating">⭐ @show.VoteAverage.ToString("0.0")</span> (@show.VoteCount.ToString("N0") oy)</p>
                <p>@(show.FirstAirDate?.Year.ToString() ?? "—") @(string.IsNullOrEmpty(show.Status) ? "" : $"· {show.Status}")</p>
            </div>

            <button class="watchlist-btn" @onclick="ToggleWatchlist">
                @(IsInWatchlist ? "❤️" : "♡")
            </button>

            @if (progress != null && progress.TotalEpisodes > 0)
            {
                var pct = (int)Math.Round(100.0 * progress.WatchedEpisodes / progress.TotalEpisodes);
                <div class="progress-block">
                    <div class="progress-bar"><div class="progress-fill" style="width:@(pct)%"></div></div>
                    <p class="progress-label">@progress.WatchedEpisodes / @progress.TotalEpisodes bölüm izlendi (@pct%)</p>
                </div>
            }
        </div>

        <div class="right-panel">
            @foreach (var season in show.Seasons)
            {
                <div class="season">
                    <div class="season-header">
                        <h4>@(string.IsNullOrEmpty(season.Name) ? $"Sezon {season.SeasonNumber}" : season.Name)</h4>
                        <button class="season-action" @onclick="() => MarkSeasonWatched(season)">Sezonu izledim</button>
                    </div>
                    <div class="episodes">
                        @foreach (var ep in season.Episodes)
                        {
                            var unaired = ep.AirDate.HasValue && ep.AirDate.Value.Date > DateTime.UtcNow.Date;
                            <div class="episode-row @(ep.Watched ? "watched" : "") @(unaired ? "unaired" : "")">
                                <label class="episode-checkbox">
                                    <input type="checkbox" checked="@ep.Watched" disabled="@unaired"
                                           @onchange="e => MarkEpisodeWatched(ep, (bool)e.Value!)" />
                                    <span>@ep.EpisodeNumber. @ep.Name</span>
                                </label>
                                @if (!ep.Watched && !unaired)
                                {
                                    <button class="up-to-btn" @onclick="() => MarkWatchedUpTo(ep)">buraya kadar</button>
                                }
                                @if (unaired && ep.AirDate.HasValue)
                                {
                                    <span class="air-date">@ep.AirDate.Value.ToString("d MMM yyyy")</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .show-loading { color: #e6e8eb; padding: 20px; }

    .show-container {
        display: flex;
        color: #e6e8eb;
        font-family: 'Segoe UI', sans-serif;
        padding: 20px;
        gap: 40px;
    }

    .left-panel { width: 260px; flex-shrink: 0; }
    .poster { width: 100%; border-radius: 8px; }
    .info { margin-top: 10px; }
    .rating { color: gold; }

    .watchlist-btn {
        margin-top: 10px;
        background: none;
        border: 1px solid #3a3d45;
        border-radius: 8px;
        font-size: 1.4rem;
        padding: 6px 14px;
        cursor: pointer;
        color: inherit;
    }

    .progress-block { margin-top: 16px; }
    .progress-bar {
        background: #2a2d35;
        border-radius: 6px;
        height: 8px;
        overflow: hidden;
    }
    .progress-fill { background: #1b6ec2; height: 100%; }
    .progress-label { font-size: 0.85rem; color: #9aa1ab; margin-top: 6px; }

    .right-panel { flex-grow: 1; min-width: 0; }

    .season { margin-bottom: 22px; }
    .season-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }
    .season-header h4 { margin: 0; }
    .season-action {
        background: none;
        border: 1px solid #3a3d45;
        border-radius: 6px;
        color: inherit;
        padding: 4px 10px;
        font-size: 0.8rem;
        cursor: pointer;
    }

    .episodes { display: flex; flex-direction: column; gap: 4px; }
    .episode-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 6px 10px;
        border-radius: 6px;
        background: var(--bw-surface);
    }
    .episode-row.watched { opacity: 0.65; }
    .episode-row.unaired { opacity: 0.5; }
    .episode-checkbox { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .episode-checkbox input { cursor: pointer; }

    .up-to-btn {
        background: none;
        border: none;
        color: #4da3ff;
        font-size: 0.78rem;
        cursor: pointer;
        white-space: nowrap;
    }
    .air-date { font-size: 0.78rem; color: #9aa1ab; white-space: nowrap; }
</style>

@code {
    [Parameter] public int TmdbId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ShowDetailDto? show;
    private ShowProgressDto? progress;
    private bool IsInWatchlist;
    private bool loading = true;

    private async Task<HttpClient> GetApiAsync()
    {
        var client = HttpClientFactory.CreateClient("ApiClient");
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var api = await GetApiAsync();

        show = await api.GetFromJsonAsync<ShowDetailDto>($"api/shows/{TmdbId}");
        if (show != null)
        {
            progress = await api.GetFromJsonAsync<ShowProgressDto>($"api/shows/{TmdbId}/progress");
            IsInWatchlist = await api.GetFromJsonAsync<bool>($"api/watchlist/status?seriesId={TmdbId}");
        }

        loading = false;
    }

    private static string PosterUrl(string? path) =>
        string.IsNullOrEmpty(path) ? "" : $"https://image.tmdb.org/t/p/w500{path}";

    private async Task ToggleWatchlist()
    {
        if (show == null) return;

        var api = await GetApiAsync();
        var series = new SeriesDto
        {
            Id = show.TmdbId,
            Name = show.Name,
            Overview = show.Overview,
            PosterPath = show.PosterPath ?? "",
            FirstAirDate = show.FirstAirDate?.ToString("yyyy-MM-dd")
        };

        var response = await api.PostAsJsonAsync("api/watchlist/toggle", series);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ToggleResponse>();
            IsInWatchlist = result!.IsInWatchList;
        }
    }

    private async Task MarkEpisodeWatched(EpisodeDetailDto episode, bool watched)
    {
        var api = await GetApiAsync();
        var response = await api.PostAsJsonAsync(
            $"api/shows/{TmdbId}/episodes/{episode.Id}/watched",
            new MarkWatchedRequest { Watched = watched });

        if (response.IsSuccessStatusCode)
        {
            episode.Watched = watched;
            progress = await response.Content.ReadFromJsonAsync<ShowProgressDto>();
        }
    }

    private async Task MarkSeasonWatched(SeasonDetailDto season)
    {
        var api = await GetApiAsync();
        var response = await api.PostAsJsonAsync(
            $"api/shows/{TmdbId}/seasons/{season.SeasonNumber}/watched",
            new MarkWatchedRequest { Watched = true });

        if (response.IsSuccessStatusCode)
        {
            foreach (var ep in season.Episodes.Where(e => !e.AirDate.HasValue || e.AirDate.Value <= DateTime.UtcNow))
                ep.Watched = true;

            var result = await response.Content.ReadFromJsonAsync<SeasonWatchedResponse>();
            progress = result?.Progress;
        }
    }

    private async Task MarkWatchedUpTo(EpisodeDetailDto target)
    {
        if (show == null) return;

        var api = await GetApiAsync();
        var response = await api.PostAsync($"api/shows/{TmdbId}/watched-up-to/{target.Id}", null);

        if (response.IsSuccessStatusCode)
        {
            var targetSeason = show.Seasons.First(s => s.Episodes.Any(e => e.Id == target.Id));
            foreach (var season in show.Seasons.Where(s => s.SeasonNumber < targetSeason.SeasonNumber))
                foreach (var ep in season.Episodes)
                    ep.Watched = true;

            foreach (var ep in targetSeason.Episodes.Where(e => e.EpisodeNumber <= target.EpisodeNumber))
                ep.Watched = true;

            var result = await response.Content.ReadFromJsonAsync<SeasonWatchedResponse>();
            progress = result?.Progress;
        }
    }

    private class ToggleResponse
    {
        public bool IsInWatchList { get; set; }
    }

    private class SeasonWatchedResponse
    {
        public int AffectedEpisodes { get; set; }
        public ShowProgressDto? Progress { get; set; }
    }
}
