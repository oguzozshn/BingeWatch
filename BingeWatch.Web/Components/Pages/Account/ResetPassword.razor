@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]

<PageMeta Title="Şifre Yenile" NoIndex="true"
          Description="Sıfırlama bağlantısıyla yeni şifreni belirle." />

<div class="container" style="max-width:420px; margin-top:3rem;">
    <h1>Şifre Yenile</h1>

    @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
    {
        <div class="alert alert-danger" role="alert">
            Bağlantı eksik ya da bozuk görünüyor.
            <a href="/forgot-password">Yeni bir bağlantı iste.</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger" role="alert">@Error</div>
        }

        <form method="post" action="/account/reset-password" data-enhance="false">
            @* Token ve e-posta gizli alanlarda taşınıyor; kullanıcı düzenlemesin. *@
            <input type="hidden" name="email" value="@Email" />
            <input type="hidden" name="token" value="@Token" />

            <div class="mb-3">
                <label class="form-label" for="reset-password">Yeni şifre</label>
                <input id="reset-password" class="form-control" type="password" name="password"
                       autocomplete="new-password" required minlength="6" />
            </div>
            <button class="btn btn-primary" type="submit">Şifreyi güncelle</button>
        </form>
        <p class="mt-3"><a href="/login">Giriş sayfasına dön</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
