@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

@using BingeWatch.Web.Dtos

<PageTitle>Ana Sayfa</PageTitle>

<h1 class="section-title">SIRADA NE VAR</h1>

@if (loading)
{
    <p class="empty-message">Yükleniyor...</p>
}
else if (!nextUp.Any())
{
    <p class="empty-message">
        Listende aktif bir dizi yok. <a href="watchlist">Watchlist'e</a> birkaç dizi ekle!
    </p>
}
else
{
    @* Kart bir gezinti; <div @onclick> klavyeyle erişilemiyordu ve orta tıkla
       yeni sekmede açmayı da engelliyordu. Poster alt metni boş: dizi adı
       zaten hemen altında, ekran okuyucu iki kez okumasın. *@
    <div class="watchlist-grid">
        @foreach (var item in nextUp)
        {
            <a class="carousel-card" href="/show/@item.TmdbShowId">
                <img src="@PosterUrl(item.ShowPosterPath)" alt="" class="series-poster" />
                <div class="series-info">
                    <h4>@item.ShowName</h4>
                    <p>
                        S@(item.SeasonNumber)E@(item.EpisodeNumber) · @item.EpisodeName
                        @if (item.ResumeAtMinutes.HasValue)
                        {
                            <br /><span class="next-up-resume">⏸ @item.ResumeAtMinutes. dakikadan devam et</span>
                        }
                        else if (item.IsUnaired && item.AirDate.HasValue)
                        {
                            <br /><span class="next-up-air-date">@item.AirDate.Value.ToString("d MMM yyyy")'de yayınlanacak</span>
                        }
                    </p>
                </div>
            </a>
        }
    </div>
}

<h2 class="section-title" style="margin-top:32px;">YAKLAŞAN BÖLÜMLER</h2>

@if (!loading && !upcoming.Any())
{
    <p class="empty-message">Önümüzdeki 30 gün içinde yeni bölüm yok.</p>
}
else if (!loading)
{
    <ul class="upcoming-list">
        @foreach (var ep in upcoming)
        {
            <li>
                <a class="upcoming-row" href="/show/@ep.TmdbShowId">
                    <time class="upcoming-date" datetime="@ep.AirDate.ToString("yyyy-MM-dd")">
                        @ep.AirDate.ToString("d MMM")
                    </time>
                    <span class="upcoming-show">@ep.ShowName</span>
                    <span class="upcoming-episode">S@(ep.SeasonNumber)E@(ep.EpisodeNumber) — @ep.EpisodeName</span>
                </a>
            </li>
        }
    </ul>
}

<style>
    .next-up-air-date { color: #9aa1ab; font-size: 0.85em; }
    .next-up-resume { color: var(--bs-warning-text-emphasis, #ffda6a); font-size: 0.85em; }

    .upcoming-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .upcoming-row {
        display: flex;
        gap: 16px;
        align-items: baseline;
        padding: 10px 14px;
        background: var(--bw-surface);
        border-radius: 8px;
        cursor: pointer;
        color: inherit;
        text-decoration: none;
    }

    .upcoming-row:hover {
        background: var(--bw-surface-2);
    }

    .upcoming-date {
        color: var(--bs-secondary-color, #9aa1ab);
        font-size: 0.85rem;
        width: 70px;
        flex-shrink: 0;
    }

    .upcoming-show { font-weight: 600; }
    .upcoming-episode { color: var(--bs-body-color, #e6e8eb); }

    /* Sırada ne var kartı da bir bağlantı; link rengini devralmasın. */
    .watchlist-grid .carousel-card {
        color: inherit;
        text-decoration: none;
    }

    /* Dar ekranda tarih/dizi/bölüm üçlüsü tek satıra sığmıyor, alt alta iniyor. */
    @@media (max-width: 600px) {
        .upcoming-row {
            flex-direction: column;
            gap: 2px;
        }

        .upcoming-date { width: auto; }
    }
</style>

@code {
    private List<NextEpisodeDto> nextUp = new();
    private List<UpcomingEpisodeDto> upcoming = new();
    private bool loading = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private async Task<HttpClient> GetApiAsync()
    {
        var client = HttpClientFactory.CreateClient("ApiClient");
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    protected override async Task OnInitializedAsync()
    {
        var api = await GetApiAsync();

        nextUp = await api.GetFromJsonAsync<List<NextEpisodeDto>>("api/progress/next-up") ?? new();
        upcoming = await api.GetFromJsonAsync<List<UpcomingEpisodeDto>>("api/progress/upcoming?days=30") ?? new();

        loading = false;
    }

    private static string PosterUrl(string? path) =>
        string.IsNullOrEmpty(path) ? "" : $"https://image.tmdb.org/t/p/w500{path}";
}
