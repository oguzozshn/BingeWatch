@page "/login"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Giriş Yap</PageTitle>

<div class="container" style="max-width:420px; margin-top:3rem;">
    <h3>Giriş Yap</h3>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger">Kullanıcı adı ya da şifre hatalı.</div>
    }
    <form method="post" action="/account/login" data-enhance="false">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="mb-3">
            <label class="form-label">Kullanıcı adı veya e-posta</label>
            <input class="form-control" name="usernameOrEmail" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Şifre</label>
            <input class="form-control" type="password" name="password" required />
        </div>
        <button class="btn btn-primary" type="submit">Giriş yap</button>
    </form>
    <p class="mt-3">Hesabın yok mu? <a href="/register">Kayıt ol</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }
}
