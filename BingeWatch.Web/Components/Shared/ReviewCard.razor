@*
    Tek bir inceleme. Hem dizi sayfasında hem /reviews akışında kullanılır;
    akışta dizi adı/posteri de gösterilir (ShowContext=true).

    Spoiler bayrağı işaretliyse gövde varsayılan olarak gizlenir — kullanıcı
    bilerek açmalı.

    Beğeni ve yorum sayıları DTO ile birlikte gelir; yorumlar ancak kullanıcı
    açtığında çekilir (ReviewComments).
*@

@inject IHttpClientFactory HttpClientFactory

<article class="review">
    @* Posterin hemen yanında aynı diziye giden metin bağlantısı da var; ikisi de
       erişilebilirlik ağacında durursa ekran okuyucu ve klavye kullanıcısı aynı
       hedefi iki kez geçiyor. Poster dekoratif sayılıp ağaçtan çıkarıldı. *@
    @if (ShowContext)
    {
        <a class="poster-link" href="/show/@Review.TmdbShowId" aria-hidden="true" tabindex="-1">
            <img class="poster" src="@PosterUrl(Review.ShowPosterPath)" alt="" />
        </a>
    }

    <div class="body-col">
        <header class="head">
            <div class="who">
                <a class="author" href="@ProfileUrl">@Review.DisplayName</a>
                @if (ShowContext)
                {
                    <a class="show-name" href="/show/@Review.TmdbShowId">@Review.ShowName</a>
                }
                @if (Review.SeasonNumber.HasValue)
                {
                    <span class="badge-season">@Review.SeasonNumber. sezon</span>
                }
            </div>

            <div class="meta">
                @if (Review.Rating.HasValue)
                {
                    <StarRating Value="Review.Rating" ReadOnly="true" Size="sm" AriaLabel="Yazarın puanı" />
                }
                <time datetime="@Review.CreatedAt.ToString("o")">@Review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</time>
            </div>
        </header>

        @if (Review.HasSpoilers && !spoilerRevealed)
        {
            <button type="button" class="spoiler-veil" @onclick="() => spoilerRevealed = true">
                Bu inceleme spoiler içeriyor — göstermek için tıkla
            </button>
        }
        else
        {
            @if (Review.HasSpoilers)
            {
                <span class="spoiler-tag">spoiler</span>
            }
            <p class="text">@Review.Body</p>
        }

        <div class="actions">
            <AuthorizeView>
                <Authorized>
                    <button type="button" class="@(liked ? "link-btn liked" : "link-btn")"
                            disabled="@likeBusy" @onclick="ToggleLikeAsync">
                        @(liked ? "♥" : "♡") @likeCount
                    </button>
                </Authorized>
                <NotAuthorized>
                    <span class="stat">♡ @likeCount</span>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button" class="link-btn" @onclick="ToggleComments">
                @(commentsOpen ? "Yorumları gizle" : $"{commentCount} yorum")
            </button>

            @if (CanEdit)
            {
                <button type="button" class="link-btn" @onclick="() => OnEdit.InvokeAsync(Review)">Düzenle</button>
                <button type="button" class="link-btn danger" @onclick="() => OnDelete.InvokeAsync(Review)">Sil</button>
            }
            else
            {
                <ReportButton TargetType="ReportTargetType.Review" TargetId="Review.Id" />
            }
        </div>

        @if (commentsOpen)
        {
            <ReviewComments ReviewId="Review.Id" OnCountChanged="OnCommentCountChanged" />
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ReviewDto Review { get; set; } = new();

    /// <summary>Akışta dizi adı ve posteri de gösterilsin mi?</summary>
    [Parameter] public bool ShowContext { get; set; }

    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public EventCallback<ReviewDto> OnEdit { get; set; }
    [Parameter] public EventCallback<ReviewDto> OnDelete { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool spoilerRevealed;

    // Beğeni/yorum durumu tıklamada yerel olarak güncellenir; liste yeniden çekilmez.
    private bool liked;
    private int likeCount;
    private int commentCount;
    private bool likeBusy;
    private bool commentsOpen;

    private int renderedReviewId;

    protected override void OnParametersSet()
    {
        // Aynı kart farklı bir incelemeye bağlandığında (liste sanallaştırma) durumu tazele.
        if (renderedReviewId == Review.Id)
            return;

        renderedReviewId = Review.Id;
        liked = Review.LikedByViewer;
        likeCount = Review.LikeCount;
        commentCount = Review.CommentCount;
        commentsOpen = false;
        spoilerRevealed = false;
    }

    private async Task ToggleLikeAsync()
    {
        likeBusy = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            var authState = await AuthStateTask!;
            var token = authState.User.FindFirst("api_token")?.Value;
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var url = $"api/reviews/{Review.Id}/like";
            var response = liked ? await client.DeleteAsync(url) : await client.PostAsync(url, null);
            if (!response.IsSuccessStatusCode)
                return;

            var state = await response.Content.ReadFromJsonAsync<ReviewLikeStateDto>();
            if (state != null)
            {
                liked = state.LikedByViewer;
                likeCount = state.LikeCount;
            }
        }
        finally
        {
            likeBusy = false;
        }
    }

    private void ToggleComments() => commentsOpen = !commentsOpen;

    private void OnCommentCountChanged(int count) => commentCount = count;

    /// <summary>Profil rotası "/@kullaniciadi"; "@" Razor'da kaçış gerektirdiği için burada birleştiriliyor.</summary>
    private string ProfileUrl => "/" + '@' + Review.Username;

    private static string PosterUrl(string? path) =>
        string.IsNullOrEmpty(path) ? "" : $"https://image.tmdb.org/t/p/w185{path}";
}
