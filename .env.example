# docker-compose.yml bu değişkenleri okur. Kopyala ve doldur:
#   cp .env.example .env
# .env git'e girmez (.gitignore).

# SQL Server sa parolası — SQL Server en az 8 karakter ve büyük/küçük harf,
# rakam, sembolden en az üçünü istiyor; aksi halde konteyner sessizce ölüyor.
MSSQL_SA_PASSWORD=

# JWT imzalama anahtarı. HMAC-SHA256 için en az 32 karakter olmalı.
# Üretmek için:  openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=BingeWatch
JWT_AUDIENCE=BingeWatch

# TMDb API anahtarı (v4 bearer token).
TMDB_API_KEY=

# Moderasyon paneline erişecek kullanıcı adı. Bu kişi önce uygulamadan
# kaydolmalı; rol bir sonraki açılışta atanıyor. Boş bırakılabilir.
ADMIN_USERNAME=
