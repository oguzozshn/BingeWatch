@page "/@{Username}"
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@using BingeWatch.Web.Models

<PageTitle>@@@Username</PageTitle>

@if (loading)
{
    <p class="muted">Yükleniyor...</p>
}
else if (profile == null)
{
    <p class="muted">Kullanıcı bulunamadı.</p>
}
else
{
    <div class="profile">
        <header class="head">
            <div>
                <h2>@profile.DisplayName</h2>
                <p class="muted">@@@profile.Username</p>
            </div>
            <FollowButton Username="@profile.Username"
                          IsFollowing="profile.IsFollowedByViewer"
                          IsViewer="profile.IsViewer"
                          OnChanged="OnFollowChanged" />
        </header>

        @if (!string.IsNullOrWhiteSpace(profile.Bio))
        {
            <p class="bio">@profile.Bio</p>
        }

        <nav class="counts">
            <a href="/@@@profile.Username/followers">
                <strong>@followerCount</strong> takipçi
            </a>
            <a href="/@@@profile.Username/following">
                <strong>@profile.FollowingCount</strong> takip
            </a>
            <a href="/@@@profile.Username/lists">
                <strong>@listCount</strong> liste
            </a>
        </nav>

        <p class="muted">Katılım: @profile.CreatedAt.ToString("d MMMM yyyy")</p>

        @if (stats != null)
        {
            <section class="stat-cards">
                <div class="stat-card">
                    <strong>@stats.WatchedEpisodeCount</strong>
                    <span>bölüm</span>
                </div>
                <div class="stat-card">
                    <strong>@stats.ShowsCompletedCount</strong>
                    <span>bitirilen dizi</span>
                </div>
                <div class="stat-card">
                    <strong>@stats.ShowsWatchingCount</strong>
                    <span>izleniyor</span>
                </div>
                <div class="stat-card">
                    <strong>@(stats.AverageRating?.ToString("0.0") ?? "—")</strong>
                    <span>ortalama puan</span>
                </div>
                <div class="stat-card">
                    <strong>@stats.ReviewCount</strong>
                    <span>inceleme</span>
                </div>
                <div class="stat-card">
                    <strong>@FormatHours(stats.TotalMinutes)</strong>
                    <span>izlenen süre</span>
                </div>
            </section>

            @if (stats.FavoriteShows.Count > 0)
            {
                <section class="favorites">
                    <h5>Favoriler</h5>
                    <div class="poster-row">
                        @foreach (var show in stats.FavoriteShows.Take(4))
                        {
                            <a href="/show/@show.TmdbId" title="@show.Name">
                                <img src="@PosterUrl(show.PosterPath)" alt="@show.Name" />
                            </a>
                        }
                    </div>
                </section>
            }

            @if (stats.YearlyCounts.Count > 0)
            {
                <section class="yearly">
                    <h5>Yıllara göre</h5>
                    @foreach (var year in stats.YearlyCounts)
                    {
                        <div class="year-row">
                            <span class="year">@year.Year</span>
                            <span class="bar" style="width: @BarWidth(year.EpisodeCount)"></span>
                            <span class="count">@year.EpisodeCount</span>
                        </div>
                    }
                </section>
            }
        }
    </div>
}

@code {
    [Parameter] public string Username { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private UserProfileDto? profile;
    private UserStatsDto? stats;
    private bool loading = true;

    // Takip butonuna basılınca sayaç sunucuya tekrar gitmeden güncellenir.
    private int followerCount;

    // Görünür liste sayısı: sahibine kapalılar da dahil, başkasına yalnızca açıklar.
    private int listCount;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        profile = null;
        stats = null;
        listCount = 0;

        var client = HttpClientFactory.CreateClient("ApiClient");
        // Token'sız istekte IsFollowedByViewer her zaman false döner; buton yanlış durumda başlar.
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        try
        {
            profile = await client.GetFromJsonAsync<UserProfileDto>($"api/users/{Uri.EscapeDataString(Username)}");
            followerCount = profile?.FollowerCount ?? 0;

            if (profile != null)
            {
                stats = await client.GetFromJsonAsync<UserStatsDto>(
                    $"api/users/{Uri.EscapeDataString(Username)}/stats");

                var lists = await client.GetFromJsonAsync<List<UserListSummaryDto>>(
                    $"api/users/{Uri.EscapeDataString(Username)}/lists");
                listCount = lists?.Count ?? 0;
            }
        }
        catch
        {
            profile = null;
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFollowChanged(bool isFollowing) => followerCount += isFollowing ? 1 : -1;

    private static string FormatHours(int minutes) =>
        minutes < 60 ? $"{minutes} dk" : $"{minutes / 60} sa";

    private static string PosterUrl(string? path) =>
        string.IsNullOrEmpty(path) ? "" : $"https://image.tmdb.org/t/p/w185{path}";

    /// <summary>Yıllık çubukların genişliği en yoğun yıla göre oranlanır.</summary>
    private string BarWidth(int count)
    {
        var max = stats?.YearlyCounts.Max(y => y.EpisodeCount) ?? 0;
        if (max == 0)
            return "0%";

        return $"{Math.Max(4, count * 100 / max)}%";
    }
}
