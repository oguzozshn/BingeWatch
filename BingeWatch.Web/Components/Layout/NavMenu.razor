@using Microsoft.AspNetCore.Components.Routing

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
    <a class="navbar-brand" href="">BingeWatch</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarContent" aria-controls="navbarContent"
            aria-expanded="false" aria-label="Gezintiyi aç/kapat">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
            <li class="nav-item">
                <NavLink class="nav-link" href="series">
                    <i class="bi bi-house-door-fill" aria-hidden="true"></i> Diziler
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="discover">
                    <i class="bi bi-compass" aria-hidden="true"></i> Keşfet
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="search">
                    <i class="bi bi-search" aria-hidden="true"></i> Ara
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="watchlist">
                    <i class="bi bi-list-nested" aria-hidden="true"></i> Watchlist
                </NavLink>
            </li>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="feed">
                            <i class="bi bi-activity" aria-hidden="true"></i> Akış
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
            <li class="nav-item">
                <NavLink class="nav-link" href="reviews">
                    <i class="bi bi-star-half" aria-hidden="true"></i> İncelemeler
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="lists">
                    <i class="bi bi-collection" aria-hidden="true"></i> Listeler
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="game">
                    <i class="bi bi-controller" aria-hidden="true"></i> Oyun
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="trivia">
                    <i class="bi bi-patch-question" aria-hidden="true"></i> Trivia
                </NavLink>
            </li>
        </ul>
        <ul class="navbar-nav mb-2 mb-lg-0">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <li class="nav-item">
                        @* Match="All": /admin/reports açıkken bu bağlantının da etkin
                           görünmemesi için — ikisi ayrı sayfa. *@
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i> Panel
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="admin/reports">
                            <i class="bi bi-shield-exclamation" aria-hidden="true"></i> Moderasyon
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <NotificationBell />
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"@{context.User.Identity!.Name}")">
                            <i class="bi bi-person-fill" aria-hidden="true"></i> @context.User.Identity!.Name
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        @* İkon dekoratif; erişilebilir ad görünmez metinden geliyor.
                           title tek başına güvenilir bir ad kaynağı değil. *@
                        <NavLink class="nav-link" href="settings/profile" title="Profil ayarları">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span class="visually-hidden">Profil ayarları</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="settings/blocks" title="Engellenenler">
                            <i class="bi bi-slash-circle" aria-hidden="true"></i>
                            <span class="visually-hidden">Engellenenler</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="/account/logout" data-enhance="false">
                            <button class="btn btn-link nav-link" type="submit">Çıkış yap</button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="login">Giriş yap</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="register">Kayıt ol</NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>
</nav>
