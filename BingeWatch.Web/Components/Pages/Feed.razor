@page "/feed"
@rendermode InteractiveServer
@attribute [Authorize]

@inject IHttpClientFactory HttpClientFactory

@*
    Sonsuz kaydırma "daha fazla" düğmesiyle. Eskiden <Virtualize> kullanılıyordu
    ama onun ItemsProvider'ı satırı indeksle istiyor (StartIndex) — imleç tabanlı
    sayfalamada indeks diye bir şey yok. Offset'te kalmak, akışa sürekli yeni olay
    girdiği için sayfa sınırında satır atlanmasına ve tekrarına yol açıyordu.
*@

<PageTitle>Akış</PageTitle>

<div class="feed-page">
    <h1>Akış</h1>

    @if (loading && activities.Count == 0)
    {
        <p class="muted">Yükleniyor...</p>
    }
    else if (activities.Count == 0)
    {
        <p class="muted">
            Akış henüz boş. Birilerini takip et ya da bir dizi puanla —
            aktiviteler burada görünür.
        </p>
    }
    else
    {
        @foreach (var activity in activities)
        {
            <div class="feed-item">
                <ActivityCard Activity="activity" />
            </div>
        }

        @if (hasMore)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary load-more"
                    disabled="@loading" @onclick="LoadPageAsync">
                @(loading ? "Yükleniyor..." : "Daha fazla")
            </button>
        }
    }
</div>

@code {
    private const int PageSize = 20;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly List<ActivityDto> activities = new();
    private bool loading = true;

    /// <summary>API'den gelen opak imleç; <c>null</c> ise sayfa kalmadı.</summary>
    private string? cursor;

    private bool hasMore;

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            var authState = await AuthStateTask!;
            var token = authState.User.FindFirst("api_token")?.Value;
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var url = $"api/feed?take={PageSize}";
            if (cursor != null)
                url += $"&cursor={Uri.EscapeDataString(cursor)}";

            var page = await client.GetFromJsonAsync<PagedResult<ActivityDto>>(url);

            activities.AddRange(page?.Items ?? new());
            cursor = page?.NextCursor;
            hasMore = cursor != null;
        }
        finally
        {
            loading = false;
        }
    }
}
