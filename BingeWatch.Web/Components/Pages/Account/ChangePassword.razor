@page "/settings/password"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

@*
    Giriş/kayıt gibi düz form gönderimi, etkileşimli bileşen değil: API taze bir
    token döndürüyor ve onu cookie'ye yazmak HttpContext gerektiriyor. Gönderim
    /account/change-password ucuna gidiyor, cookie orada yenileniyor.
*@

<PageMeta Title="Şifre değiştir" NoIndex="true" />

<div class="container" style="max-width:420px; margin-top:3rem;">
    <h1>Şifre değiştir</h1>

    @if (Changed == "1")
    {
        @* "Oturumlar kapatıldı" demiyoruz: token geçersizleşiyor ama o
           cihazlardaki sayfa hâlâ girişli görünüyor, yalnızca sunucuya
           yaptığı her istek reddediliyor. Söz verilen şey olanla aynı olmalı. *@
        <div class="alert alert-success" role="alert">
            Şifren güncellendi. Diğer cihazlardaki oturumlar geçersizleşti;
            oralarda yeniden giriş yapman gerekecek.
        </div>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }

    <form method="post" action="/account/change-password" data-enhance="false">
        <div class="mb-3">
            <label class="form-label" for="current-password">Mevcut şifren</label>
            <input id="current-password" class="form-control" type="password" name="currentPassword"
                   autocomplete="current-password" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="new-password">Yeni şifre</label>
            <input id="new-password" class="form-control" type="password" name="newPassword"
                   autocomplete="new-password" minlength="6" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="confirm-password">Yeni şifre (tekrar)</label>
            <input id="confirm-password" class="form-control" type="password" name="confirmPassword"
                   autocomplete="new-password" minlength="6" required />
        </div>
        <button class="btn btn-primary" type="submit">Şifreyi değiştir</button>
    </form>

    <p class="mt-3 muted">
        Şifreni değiştirdiğinde bu tarayıcı açık kalır; diğer cihazlardaki
        oturumlar geçersizleşir.
    </p>
    <p><a href="/settings/profile">Profil ayarlarına dön</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "changed")]
    private string? Changed { get; set; }
}
