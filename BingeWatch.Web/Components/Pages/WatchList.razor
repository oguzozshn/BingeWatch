@page "/watchlist"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory

@using System.Security.Claims
@using BingeWatch.Web.Models
@using BingeWatch.Web.Dtos
@using Microsoft.AspNetCore.Components.Web
@inject ILogger<WatchList> Logger


<PageTitle>Watchlist</PageTitle>

<h1 class="section-title">WATCHLIST'İM</h1>

<div class="search-section">
    <div class="search-container">
        <div class="search-input-wrapper">
            <label class="visually-hidden" for="series-search">Dizi ara</label>
            <input id="series-search"
                   type="search"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeyup="OnSearchInput"
                   @onfocus="OnSearchFocus"
                   @onblur="OnSearchBlur"
                   placeholder="Dizi ara..."
                   class="search-input"
                   role="combobox"
                   aria-controls="series-search-results"
                   aria-expanded="@Aria(showDropdown && searchResults.Any())"
                   aria-autocomplete="list" />

            @if (showDropdown && searchResults.Any())
            {
                @* Öneriler eskiden <div @onclick> idi: klavyeyle seçilemiyordu.
                   @onmousedown:preventDefault, tıklamanın input'u blur etmesini
                   ve OnSearchBlur'ün listeyi erkenden kapatmasını engelliyor —
                   ROADMAP §7.1'deki "arama butonu blur yarışı" da bu yüzdendi. *@
                <ul id="series-search-results" class="search-dropdown"
                    aria-label="Arama önerileri" @onmousedown:preventDefault>
                    @foreach (var series in searchResults.Take(8))
                    {
                        <li>
                            <button type="button" class="dropdown-item"
                                    @onclick="() => SelectSeries(series)">
                                <img src="@($"https://image.tmdb.org/t/p/w92{series.PosterPath}")"
                                     alt="" class="dropdown-poster" />
                                <span class="dropdown-info">
                                    <span class="dropdown-title">@series.Name</span>
                                    <span class="dropdown-overview">@series.Overview</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
        <button type="button" @onclick="SearchSeries" class="search-button">Ara</button>
    </div>
</div>

<div class="watchlist-section">
    <h3>Watchlist'im (@watchList.Count dizi)</h3>
    @if (watchList.Any())
    {
        @* Kart eskiden <div @onclick> içinde ayrı bir butonla geliyordu:
           tıklanabilir kartın içine buton koymak hem klavyede hem ekran
           okuyucuda çıkmaza sokuyor. Gezinti başlıktaki bağlantıda,
           kaldırma ayrı bir buton olarak yanında. *@
        <ul class="watchlist-grid">
            @foreach (var series in watchList)
            {
                <li class="series-card">
                    <a class="card-link" href="/show/@series.Id">
                        <img src="@($"https://image.tmdb.org/t/p/w500{series.PosterPath}")"
                             alt="" class="series-poster" />
                        <span class="card-title">@series.Name</span>
                    </a>
                    <div class="series-info">
                        <p>@series.Overview</p>
                        <button type="button" class="remove-button"
                                @onclick="() => RemoveFromWatchList(series)">
                            Kaldır<span class="visually-hidden"> — @series.Name</span>
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="empty-message">Watchlist'in boş. Yukarıdan dizi arayıp ekleyebilirsin.</p>
    }
</div>

@code {
    private string searchQuery = "";
    private List<SeriesDto> searchResults = new();
    private List<SeriesDto> watchList = new();
    private Timer? searchTimer;
    private bool showDropdown = false;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private async Task<HttpClient> GetApiAsync()
    {
        var client = HttpClientFactory.CreateClient("ApiClient");
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWatchList();
    }

    private async Task LoadWatchList()
    {
        try
        {
            var api = await GetApiAsync();
            watchList = await api.GetFromJsonAsync<List<SeriesDto>>("api/watchlist/mine") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Watchlist okunamadı.");
            watchList = new();
        }
    }

    private async Task OnSearchInput(KeyboardEventArgs e)
    {

        searchTimer?.Dispose();
        searchTimer = new Timer(async _ => await SearchSeries(), null, 300, Timeout.Infinite);
    }

    private void OnSearchFocus()
    {
        if (searchResults.Any())
        {
            showDropdown = true;
        }
    }

    private void OnSearchBlur()
    {
        Task.Delay(200).ContinueWith(_ => 
        {
            InvokeAsync(() => 
            {
                showDropdown = false;
                StateHasChanged();
            });
        });
    }

    private async Task SearchSeries()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            showDropdown = false;
            return;
        }

        try
        {
            var api = await GetApiAsync();
            searchResults = await api.GetFromJsonAsync<List<SeriesDto>>($"api/watchlist/search?query={Uri.EscapeDataString(searchQuery)}") ?? new();
            showDropdown = searchResults.Any();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dizi araması başarısız oldu.");
            searchResults = new();
            showDropdown = false;
        }
    }

    private async Task SelectSeries(SeriesDto series)
    {
        await AddToWatchList(series);
        searchQuery = "";
        searchResults.Clear();
        showDropdown = false;
    }

    private async Task AddToWatchList(SeriesDto series)
    {
        try
        {
            var api = await GetApiAsync();
            var response = await api.PostAsJsonAsync("api/watchlist/add", series);
            
            if (response.IsSuccessStatusCode)
            {
                await LoadWatchList();
            }
            else
            {
                Logger.LogWarning("Watchlist'e ekleme başarısız: {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Watchlist'e ekleme başarısız oldu.");
        }
    }

    private async Task RemoveFromWatchList(SeriesDto series)
    {
        try
        {
            var api = await GetApiAsync();
            var response = await api.DeleteAsync($"api/watchlist/remove/{series.Id}");
            
            if (response.IsSuccessStatusCode)
            {
                await LoadWatchList();
            }
            else
            {
                Logger.LogWarning("Watchlist'ten çıkarma başarısız: {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Watchlist'ten çıkarma başarısız oldu.");
        }
    }

    public void Dispose()
    {
        searchTimer?.Dispose();
    }
}

