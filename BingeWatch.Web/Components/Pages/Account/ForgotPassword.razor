@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]

<PageMeta Title="Şifremi Unuttum" NoIndex="true"
          Description="Hesabının şifresini sıfırlamak için bağlantı iste." />

<div class="container" style="max-width:420px; margin-top:3rem;">
    <h1>Şifremi Unuttum</h1>

    @if (Sent)
    {
        @* Bilerek "böyle bir hesap yok" demiyoruz: e-postayı tek tek deneyerek
           kimin üye olduğunu öğrenmeye izin verirdi. Yanıt her durumda aynı. *@
        <div class="alert alert-success" role="alert">
            Kayıtlı bir hesap varsa sıfırlama bağlantısı gönderildi.
            Gelen kutunu kontrol et.
        </div>
        <p><a href="/login">Giriş sayfasına dön</a></p>
    }
    else
    {
        @if (Unavailable)
        {
            <div class="alert alert-warning" role="alert">
                Şifre sıfırlama şu an kullanılamıyor. Lütfen daha sonra tekrar dene.
            </div>
        }

        <p class="muted">
            Hesabının e-posta adresini gir; şifreni yenileyebileceğin bir bağlantı gönderelim.
        </p>

        <form method="post" action="/account/forgot-password" data-enhance="false">
            <div class="mb-3">
                <label class="form-label" for="forgot-email">E-posta</label>
                <input id="forgot-email" class="form-control" type="email" name="email"
                       autocomplete="email" required />
            </div>
            <button class="btn btn-primary" type="submit">Bağlantı gönder</button>
        </form>
        <p class="mt-3"><a href="/login">Giriş sayfasına dön</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    private string? SentFlag { get; set; }

    [SupplyParameterFromQuery(Name = "unavailable")]
    private string? UnavailableFlag { get; set; }

    private bool Sent => SentFlag == "1";
    private bool Unavailable => UnavailableFlag == "1";
}
