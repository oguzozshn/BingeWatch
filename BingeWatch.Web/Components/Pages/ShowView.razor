@page "/show/{ImdbId}/{SeriesId}"

@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

@using System.Globalization
@using BingeWatch.Web.Dtos
@using BingeWatch.Web.Models

<div class="show-container">
    <div class="left-panel">
        <img src="@PosterUrl" alt="@ShowTitle" class="poster" />

        <div class="info">
            <h2>@ShowTitle</h2>
            <p><span class="rating">⭐ @ShowRating</span> (@Votes votes)</p>
            <p>@ShowYear - now</p>
        </div>

        <button class="watchlist-btn" @onclick="ToggleWatchlist">
            @(IsInWatchlist ? "❤️" : "♡")
        </button>
    </div>

    <div class="right-panel">
        <div class="legend">
            <span class="dot awesome"></span> Awesome
            <span class="dot great"></span> Great
            <span class="dot good"></span> Good
            <span class="dot regular"></span> Regular
            <span class="dot bad"></span> Bad
            <span class="dot garbage"></span> Garbage
        </div>

        <div class="seasons">
            @foreach (var season in SeasonGroups)
            {
                <div class="season">
                    <h4>@($"S{season.Key}")</h4>
                    <div class="episodes">
                        @foreach (var ep in season.Value)
                        {
                            <div class="episode-box"
                                 title="@($"{ep.Title}\nSeason {ep.Season}, Episode {ep.Episode}")"
                                 style="background-color:@GetColor(ep.imdbRating)">
                                @(string.IsNullOrEmpty(ep.imdbRating) ? "?" : ep.imdbRating)
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .show-container {
        display: flex;
        color: white;
        background-color: #111;
        font-family: 'Segoe UI', sans-serif;
        padding: 20px;
    }

    .left-panel {
        width: 250px;
    }

    .poster {
        width: 100%;
        border-radius: 8px;
    }

    .info {
        margin-top: 10px;
    }

    .rating {
        color: gold;
    }

    .right-panel {
        flex-grow: 1;
        margin-left: 40px;
    }

    .legend {
        margin-bottom: 10px;
    }

    .dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 4px;
    }

    .awesome { background: #00ff66; }
    .great   { background: #6fff00; }
    .good    { background: #ccff00; }
    .regular { background: #ffaa00; }
    .bad     { background: #ff5500; }
    .garbage { background: #aa00ff; }

    .seasons {
        display: flex;
        gap: 30px;
    }

    .episodes {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .episode-box {
        width: 50px;
        height: 30px;
        text-align: center;
        border-radius: 6px;
        line-height: 30px;
        font-weight: bold;
        background: gray;
        color: black;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public string ImdbId { get; set; }
    [Parameter] public string SeriesId { get; set; }

    private const string UserId = "user1";
    private const string TmdbImageBaseUrl = "https://image.tmdb.org/t/p/w500";

    private string OmdbApiKey;
    private string TmdbApiKey;
    private string PosterUrl;
    private string ShowTitle;
    private string ShowYear;
    private string ShowRating;
    private string Votes;

    private bool IsInWatchlist;
    private bool _watchlistLoaded;

    private List<OmdbEpisodeRatingModel> Episodes = new();
    private List<int> SeasonNumbers = new();
    private Dictionary<int, List<OmdbEpisodeRatingModel>> SeasonGroups = new();

    // 1️⃣ SADECE OMDb – LOCAL DATA
    protected override async Task OnInitializedAsync()
    {
        OmdbApiKey = Configuration["OmdbApiKey"];
        TmdbApiKey = Configuration["TmdbApiKey"];

        await LoadShowDetailsAsync();
        await LoadEpisodeRatingsAsync();

        SeasonGroups = Episodes
            .Where(e => int.TryParse(e.Season, out _))
            .GroupBy(e => int.Parse(e.Season))
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.OrderBy(e => int.Parse(e.Episode)).ToList());
    }

    private async Task LoadShowDetailsAsync()
    {
        await LoadTmdbShowDetailsAsync();

        if (!string.IsNullOrWhiteSpace(ShowTitle) && SeasonNumbers.Any())
            return;

        var showData = await GetExternalJsonAsync<OmdbShowModel>(
            $"https://www.omdbapi.com/?i={ImdbId}&apikey={OmdbApiKey}"
        );

        if (!string.IsNullOrWhiteSpace(showData?.Title) && showData.Title != "N/A")
        {
            PosterUrl = showData.Poster;
            ShowTitle = showData.Title;
            ShowYear = showData.Year;
            ShowRating = showData.imdbRating;
            Votes = showData.imdbVotes;

            if (int.TryParse(showData.totalSeasons, out var totalSeasons))
                SeasonNumbers = Enumerable.Range(1, totalSeasons).ToList();
        }

        if (!SeasonNumbers.Any() && int.TryParse(showData?.totalSeasons, out var fallbackTotalSeasons))
            SeasonNumbers = Enumerable.Range(1, fallbackTotalSeasons).ToList();
    }

    private async Task LoadEpisodeRatingsAsync()
    {
        await LoadTmdbEpisodeRatingsAsync();

        if (!Episodes.Any())
            await LoadOmdbEpisodeRatingsAsync();
    }

    private async Task LoadOmdbEpisodeRatingsAsync()
    {
        foreach (var season in SeasonNumbers.DefaultIfEmpty().Where(s => s > 0))
        {
            var url = $"https://www.omdbapi.com/?i={ImdbId}&Season={season}&apikey={OmdbApiKey}";
            var seasonData = await GetExternalJsonAsync<OmdbSeasonResponse>(url);

            if (seasonData?.Episodes != null)
            {
                foreach (var ep in seasonData.Episodes)
                    ep.Season = season.ToString();

                Episodes.AddRange(seasonData.Episodes);
            }
        }
    }

    private async Task LoadTmdbShowDetailsAsync()
    {
        if (!int.TryParse(SeriesId, out var tmdbSeriesId) || string.IsNullOrWhiteSpace(TmdbApiKey))
            return;

        var details = await GetExternalJsonAsync<TmdbShowDetailsModel>(
            $"https://api.themoviedb.org/3/tv/{tmdbSeriesId}?api_key={TmdbApiKey}"
        );

        if (details == null)
            return;

        ShowTitle ??= details.Name;
        ShowYear ??= details.FirstAirDate?.Split('-').FirstOrDefault();
        ShowRating ??= details.VoteAverage.ToString("0.0", CultureInfo.InvariantCulture);
        Votes ??= details.VoteCount.ToString("N0", CultureInfo.InvariantCulture);

        if (string.IsNullOrWhiteSpace(PosterUrl) && !string.IsNullOrWhiteSpace(details.PosterPath))
            PosterUrl = $"{TmdbImageBaseUrl}{details.PosterPath}";

        SeasonNumbers = details.Seasons?
            .Where(s => s.SeasonNumber > 0 && s.EpisodeCount > 0)
            .Select(s => s.SeasonNumber)
            .OrderBy(s => s)
            .ToList() ?? new();
    }

    private async Task LoadTmdbEpisodeRatingsAsync()
    {
        if (!int.TryParse(SeriesId, out var tmdbSeriesId) || string.IsNullOrWhiteSpace(TmdbApiKey))
            return;

        if (!SeasonNumbers.Any())
            await LoadTmdbShowDetailsAsync();

        foreach (var season in SeasonNumbers)
        {
            var seasonData = await GetExternalJsonAsync<TmdbSeasonResponse>(
                $"https://api.themoviedb.org/3/tv/{tmdbSeriesId}/season/{season}?api_key={TmdbApiKey}"
            );

            if (seasonData?.Episodes == null)
                continue;

            Episodes.AddRange(seasonData.Episodes.Select(ep => new OmdbEpisodeRatingModel
            {
                Title = ep.Name,
                Season = ep.SeasonNumber.ToString(),
                Episode = ep.EpisodeNumber.ToString(),
                imdbRating = ep.VoteAverage > 0
                    ? ep.VoteAverage.ToString("0.0", CultureInfo.InvariantCulture)
                    : ""
            }));
        }
    }

    private static async Task<T> GetExternalJsonAsync<T>(string url)
    {
        try
        {
            using var client = new HttpClient
            {
                Timeout = TimeSpan.FromSeconds(3)
            };

            return await client.GetFromJsonAsync<T>(url);
        }
        catch
        {
            return default;
        }
    }

    // 2️⃣ API ÇAĞRISI – DOĞRU LIFECYCLE
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _watchlistLoaded)
            return;

        _watchlistLoaded = true;

        var api = HttpClientFactory.CreateClient("ApiClient");

        IsInWatchlist = await api.GetFromJsonAsync<bool>(
            $"api/watchlist/status?userId={UserId}&seriesId={SeriesId}"
        );

        StateHasChanged();
    }

    // 3️⃣ TOGGLE
    private async Task ToggleWatchlist()
    {
        Console.WriteLine("TOGGLE CLICKED");

        var api = HttpClientFactory.CreateClient("ApiClient");

        var series = new SeriesDto
        {
            Id = int.Parse(SeriesId),
            Name = ShowTitle,
            PosterPath = PosterUrl,
            FirstAirDate = ShowYear
        };

        var response = await api.PostAsJsonAsync(
            $"api/watchlist/user/{UserId}/toggle",
            series
        );

        Console.WriteLine($"STATUS: {response.StatusCode}");

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ToggleResponse>();
            IsInWatchlist = result.IsInWatchList;
        }
    }

    private string GetColor(string ratingStr)
    {
        if (!double.TryParse(ratingStr, NumberStyles.Any, CultureInfo.InvariantCulture, out var rating))
            return "gray";

        return rating switch
        {
            >= 9 => "#00ff66",
            >= 8 => "#6fff00",
            >= 7 => "#ccff00",
            >= 6 => "#ffaa00",
            >= 5 => "#ff5500",
            _ => "#aa00ff"
        };
    }

    public class ToggleResponse
    {
        public bool IsInWatchList { get; set; }
    }
}
