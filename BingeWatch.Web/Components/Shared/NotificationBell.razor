@*
    Navbar'daki zil. Okunmamış sayısını sayfa yüklenirken bir kez çeker;
    canlı sayaç (SignalR push) Faz 6'ya bırakıldı.
*@

@inject IHttpClientFactory HttpClientFactory

@* Bağlantının tek içeriği bir ikon fontuydu; erişilebilir adı yoktu ve rozetteki
   sayı bağlamsız "3" olarak okunuyordu. Ad artık sayıyı da içeriyor. *@
<NavLink class="nav-link bell" href="notifications" aria-label="@Label">
    <i class="bi bi-bell-fill" aria-hidden="true"></i>
    @if (unreadCount > 0)
    {
        <span class="badge" aria-hidden="true">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
    }
</NavLink>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int unreadCount;

    private string Label => unreadCount switch
    {
        0 => "Bildirimler",
        1 => "Bildirimler — 1 okunmamış",
        _ => $"Bildirimler — {unreadCount} okunmamış"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        var token = authState.User.FindFirst("api_token")?.Value;
        if (string.IsNullOrEmpty(token))
            return;

        var client = HttpClientFactory.CreateClient("ApiClient");
        client.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        try
        {
            unreadCount = await client.GetFromJsonAsync<int>("api/notifications/unread-count");
        }
        catch
        {
            // Sayaç okunamazsa zil rozetsiz gösterilir; navbar'ı düşürmeye değmez.
            unreadCount = 0;
        }
    }
}
