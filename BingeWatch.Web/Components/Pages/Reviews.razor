@page "/reviews"
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory

<PageMeta Title="İncelemeler"
          Description="BingeWatch kullanıcılarının dizi incelemeleri — en yeni, en eski ya da en yüksek puanlı." />

<div class="reviews-page">
    <header class="page-head">
        <h1>İncelemeler</h1>
        <select class="form-select form-select-sm sort-select" aria-label="İncelemeleri sırala"
                value="@((int)sort)"
                @onchange="OnSortChangedAsync">
            <option value="0">En yeni</option>
            <option value="1">En eski</option>
            <option value="2">En yüksek puan</option>
        </select>
    </header>

    @if (loading && reviews.Count == 0)
    {
        <p class="muted">Yükleniyor...</p>
    }
    else if (reviews.Count == 0)
    {
        <p class="muted">Henüz hiç inceleme yazılmamış.</p>
    }
    else
    {
        <div class="review-list">
            @foreach (var review in reviews)
            {
                <ReviewCard Review="review" ShowContext="true" CanEdit="false" />
            }
        </div>

        @if (hasMore)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary load-more"
                    disabled="@loading" @onclick="LoadMoreAsync">
                @(loading ? "Yükleniyor..." : "Daha fazla")
            </button>
        }
    }
</div>

@code {
    private const int PageSize = 20;

    private readonly List<ReviewDto> reviews = new();
    private ReviewSort sort = ReviewSort.Newest;
    private bool loading = true;

    /// <summary>API'den gelen opak imleç; <c>null</c> ise sayfa kalmadı.</summary>
    private string? cursor;

    private bool hasMore;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private HttpClient Api => HttpClientFactory.CreateClient("ApiClient");

    private async Task ReloadAsync()
    {
        loading = true;
        reviews.Clear();
        cursor = null;
        await LoadPageAsync();
    }

    private async Task LoadMoreAsync()
    {
        loading = true;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        var url = $"api/reviews?take={PageSize}&sort={(int)sort}";
        if (cursor != null)
            url += $"&cursor={Uri.EscapeDataString(cursor)}";

        var page = await Api.GetFromJsonAsync<PagedResult<ReviewDto>>(url);

        reviews.AddRange(page?.Items ?? new());
        // Sayfanın devamı olup olmadığını sunucu söylüyor; istemci tahmin etmiyor.
        cursor = page?.NextCursor;
        hasMore = cursor != null;
        loading = false;
    }

    private async Task OnSortChangedAsync(ChangeEventArgs e)
    {
        sort = (ReviewSort)int.Parse(e.Value?.ToString() ?? "0");
        await ReloadAsync();
    }
}
